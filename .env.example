# Site
NEXT_PUBLIC_SITE_URL=https://klandweb.com

# REQUIRED in production — generate a long random string (32+ chars)
# Example: openssl rand -base64 48
JWT_SECRET=

# Database (optional — falls back to local data/portfolio.db)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Google reCAPTCHA v3 — optional fallback.
# Preferred: set Site Key + Secret Key in Admin → Settings → reCAPTCHA.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Force captcha even if keys missing (blocks login/contact until configured):
# RECAPTCHA_REQUIRED=true
