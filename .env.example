# Site
NEXT_PUBLIC_SITE_URL=https://klandweb.com
JWT_SECRET=change-me-to-a-long-random-string

# Database (optional — falls back to local data/portfolio.db)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Google reCAPTCHA v3 (admin login + contact form + site-wide)
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Set to true in production to reject requests when captcha is missing
# RECAPTCHA_REQUIRED=true
